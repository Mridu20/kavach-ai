      >
        <ScanLine size={17} />
        Start Analysis
      </button>
    </div>
  );
};

// ── Phase 2: Scanning in Progress ────────────────────────────────────────────

const ScanningPhase: React.FC<{ files: File[]; query: string }> = ({ files }) => {
