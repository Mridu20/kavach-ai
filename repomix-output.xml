import React, { useState } from "react";
import {
  FileText,
  Table,
  Terminal,
  Download,
  CheckCircle2,
  AlertTriangle,
  FileCheck,
  Building2,
  Copy,
  Check,
} from "lucide-react";
import { AgentState } from "../types/agent";

interface DeliverablesPreviewProps {
  state: AgentState;
