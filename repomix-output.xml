                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <UploadCloud size={28} color="var(--text-dim)" />
            </div>
            <div style={{ textAlign: "center" }}>
              <p style={{ fontWeight: 600, fontSize: "0.95rem", color: "var(--text-primary)" }}>
